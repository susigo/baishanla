.thumb {
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: inset 0 0 0 2rpx rgba(229, 224, 212, 0.6);
  background:
    radial-gradient(circle at 35% 30%, rgba(231, 184, 176, 0.85), transparent 55%),
    linear-gradient(145deg, #E8F2EC, #F6E8E5);
}

.thumb.floral {
  background:
    radial-gradient(circle at 70% 30%, rgba(231, 184, 176, 0.9), transparent 50%),
    linear-gradient(145deg, #F6E8E5, #E8F2EC);
}

.thumb.sage {
  background:
    radial-gradient(circle at 40% 40%, rgba(123, 175, 158, 0.55), transparent 55%),
    linear-gradient(145deg, #E8F2EC, #F7F3EA);
}

.thumb.blush {
  background:
    radial-gradient(circle at 50% 40%, rgba(231, 184, 176, 0.75), transparent 55%),
    linear-gradient(145deg, #F6E8E5, #F7F3EA);
}
