.empty {
  text-align: center;
  padding: 72rpx 32rpx 48rpx;
  position: relative;
}

.blob {
  width: 168rpx;
  height: 168rpx;
  margin: 0 auto 16rpx;
  border-radius: 50%;
  background:
    radial-gradient(circle at 35% 30%, rgba(231, 184, 176, 0.75), transparent 55%),
    linear-gradient(145deg, #E8F2EC, #F6E8E5);
  box-shadow: 0 16rpx 40rpx rgba(47, 58, 54, 0.06);
}

.sprout {
  width: 16rpx;
  height: 36rpx;
  margin: -84rpx auto 56rpx;
  background: #7BAF9E;
  border-radius: 8rpx;
  position: relative;
}

.sprout::before,
.sprout::after {
  content: "";
  position: absolute;
  width: 28rpx;
  height: 20rpx;
  background: #7BAF9E;
  border-radius: 50%;
  top: -6rpx;
}

.sprout::before { left: -22rpx; transform: rotate(-28deg); }
.sprout::after { right: -22rpx; transform: rotate(28deg); }

.title {
  font-weight: 600;
  font-size: 32rpx;
  color: #2F3A36;
}

.desc {
  color: #6B776F;
  font-size: 26rpx;
  line-height: 1.55;
  margin: 12rpx auto 0;
  max-width: 480rpx;
}

.btn {
  margin-top: 28rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: #7BAF9E;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 300rpx;
  margin-left: auto;
  margin-right: auto;
  box-shadow: 0 12rpx 28rpx rgba(123, 175, 158, 0.28);
}

.btn::after { border: none; }
