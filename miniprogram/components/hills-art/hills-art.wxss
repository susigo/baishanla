.art {
  border-radius: 40rpx;
  position: relative;
  overflow: hidden;
  border: 3rpx dashed #B7D0C4;
}

.cover {
  width: 100%;
  height: 100%;
  display: block;
}

.wash {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 22% 28%, rgba(231, 184, 176, 0.18), transparent 46%);
  pointer-events: none;
}

.label {
  position: absolute;
  left: 24rpx;
  bottom: 16rpx;
  color: #5F9483;
  font-size: 24rpx;
  background: rgba(247, 243, 234, 0.78);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
