page {
  background: #F7F3EA;
  color: #2F3A36;
  font-family: "PingFang SC", "Noto Sans SC", "Hiragino Sans GB", system-ui, sans-serif;
  font-size: 28rpx;
  min-height: 100%;
}

.page {
  padding: 24rpx 40rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.page-tab {
  padding-bottom: 48rpx;
}

.spring {
  position: relative;
  overflow: hidden;
}

.spring::before {
  content: "";
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(231, 184, 176, 0.35), transparent 70%);
  pointer-events: none;
}

.spring::after {
  content: "";
  position: absolute;
  bottom: 10%;
  left: -100rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(123, 175, 158, 0.22), transparent 70%);
  pointer-events: none;
}

.card {
  background: #fff;
  border-radius: 36rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 20rpx 56rpx rgba(47, 58, 54, 0.07);
}

.card-sage {
  background: linear-gradient(145deg, #E5F0EB 0%, #F4F8F5 55%, #F7F3EA 100%);
  border-radius: 36rpx;
  padding: 32rpx 36rpx;
  box-shadow: 0 20rpx 56rpx rgba(47, 58, 54, 0.05);
  border: 2rpx solid rgba(183, 208, 196, 0.45);
}

.card-dash {
  border: 2rpx dashed rgba(123, 175, 158, 0.7);
  background: transparent;
  box-shadow: none;
  border-radius: 36rpx;
  padding: 28rpx 32rpx;
  color: #6B776F;
  font-size: 26rpx;
}

button {
  margin: 0;
  padding: 0;
  background: none;
  border: none;
  line-height: inherit;
  font-size: inherit;
  font-weight: inherit;
  color: inherit;
}

button::after {
  border: none;
}

.btn-primary {
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  background: #7BAF9E;
  color: #fff;
  width: 100%;
  box-shadow: 0 16rpx 40rpx rgba(123, 175, 158, 0.35);
}

.btn-primary:active {
  background: #5F9483;
}

.btn-secondary {
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  background: transparent;
  color: #5F9483;
  border: 3rpx solid #7BAF9E;
  width: 100%;
}

.btn-ghost {
  height: 80rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  background: #fff;
  color: #5F9483;
  border: 3rpx solid #7BAF9E;
  padding: 0 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(47, 58, 54, 0.04);
}

.btn-dashed {
  height: 80rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  background: transparent;
  color: #5F9483;
  border: 3rpx dashed #7BAF9E;
  padding: 0 32rpx;
}

.btn-wx {
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  background: #07C160;
  color: #fff;
  width: 100%;
  box-shadow: 0 16rpx 40rpx rgba(7, 193, 96, 0.28);
}

.btn-wx:active {
  opacity: 0.9;
}

.btn-text {
  width: 100%;
  text-align: center;
  color: #6B776F;
  font-size: 28rpx;
  padding: 16rpx 0;
  background: transparent;
}

.field {
  min-height: 92rpx;
  background: #fff;
  border: 2rpx solid #E5E0D4;
  border-radius: 28rpx;
  padding: 20rpx 28rpx;
  color: #2F3A36;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  box-shadow: 0 8rpx 28rpx rgba(47, 58, 54, 0.04);
}

.field-area {
  min-height: 192rpx;
  width: 100%;
}

.chip {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 2rpx solid #E5E0D4;
  font-size: 24rpx;
  color: #6B776F;
  box-shadow: 0 4rpx 16rpx rgba(47, 58, 54, 0.04);
}

.muted {
  color: #6B776F;
  font-size: 26rpx;
}

.ink {
  color: #2F3A36;
}

.sage {
  color: #5F9483;
}

.blush {
  color: #E7B8B0;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
}

.h1 {
  font-size: 44rpx;
  font-weight: 600;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.gap-2 {
  margin-bottom: 16rpx;
}

.gap-3 {
  margin-bottom: 24rpx;
}

.mt-2 { margin-top: 16rpx; }
.mt-3 { margin-top: 24rpx; }
.mt-4 { margin-top: 32rpx; }
.mb-2 { margin-bottom: 16rpx; }
.mb-3 { margin-bottom: 24rpx; }
.mb-4 { margin-bottom: 32rpx; }

.progress {
  height: 16rpx;
  background: #F0EBE0;
  border-radius: 999rpx;
  overflow: hidden;
  margin-top: 20rpx;
}

.progress-bar {
  height: 100%;
  background: #7BAF9E;
  border-radius: 999rpx;
}

.check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid #7BAF9E;
  flex-shrink: 0;
  background: #fff;
  position: relative;
}

.check.on::after {
  content: "";
  position: absolute;
  inset: 8rpx;
  border-radius: 50%;
  background: #7BAF9E;
}

.map-placeholder {
  height: 360rpx;
  border-radius: 36rpx;
  background:
    linear-gradient(#0000 49%, #d5d0c4 50%, #0000 51%),
    linear-gradient(90deg, #0000 49%, #d5d0c4 50%, #0000 51%),
    #E7EFE9;
  background-size: 72rpx 72rpx;
  position: relative;
  border: 2rpx solid #E5E0D4;
  box-shadow: 0 16rpx 48rpx rgba(47, 58, 54, 0.05);
}

.map-pin {
  position: absolute;
  left: 50%;
  top: 44%;
  width: 32rpx;
  height: 32rpx;
  background: #E7B8B0;
  border: 4rpx solid #2F3A36;
  border-radius: 50% 50% 50% 0;
  transform: translate(-50%, -100%) rotate(-45deg);
}

.cover-photo {
  background:
    radial-gradient(circle at 30% 25%, rgba(231, 184, 176, 0.45), transparent 50%),
    linear-gradient(160deg, #E8F2EC 0%, #F7F3EA 50%, #F6E8E5 100%);
  border: 2rpx solid #E5E0D4;
  border-radius: 24rpx;
  position: relative;
  overflow: hidden;
}

.sprout-line {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: #B7D0C4;
  margin: 24rpx 0;
  font-size: 24rpx;
}

.sprout-line::before,
.sprout-line::after {
  content: "";
  height: 2rpx;
  width: 80rpx;
  background: #B7D0C4;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 600;
  font-size: 36rpx;
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.grid-3 {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
}

.photo-slot {
  aspect-ratio: 1;
  border-radius: 24rpx;
  overflow: hidden;
}

.photo-add {
  aspect-ratio: 1;
  border-radius: 24rpx;
  border: 2rpx dashed rgba(123, 175, 158, 0.5);
  background: #F0EBE0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5F9483;
  font-size: 48rpx;
}

.item-row {
  display: flex;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #E5E0D4;
  align-items: flex-start;
}

button.btn-primary,
button.btn-secondary,
button.btn-wx {
  width: 100%;
  box-sizing: border-box;
}
