<view class="page">
  <view class="row mb-3">
    <view></view>
    <view class="chip" bindtap="goNew">＋ 新建</view>
  </view>
  <view wx:for="{{schedules}}" wx:key="id" class="card mb-3">
    <view style="font-weight:600;">{{item.type}} · {{item.date}}</view>
    <view class="muted mt-2">{{item.meta}}</view>
    <view class="chip-row">
      <view wx:for="{{item.remindChips}}" wx:for-item="c" wx:key="*this" class="chip">{{c}}</view>
      <view class="chip">{{item.ruleLabel}}</view>
    </view>
  </view>
  <empty-state wx:if="{{!schedules.length}}" title="暂无排程" description="把清明、忌日记下来，到时候轻轻提醒家人。" action-label="新建排程" bind:action="goNew" />
  <button class="btn-secondary mt-4" bindtap="stubSubscribe">订阅提醒（占位）</button>
</view>
