<view class="page">
  <view class="row mb-3">
    <view class="h1">排程</view>
    <view wx:if="{{canEdit}}" class="chip" bindtap="goNew">＋ 新建</view>
  </view>

  <view class="sub-card {{subscribed ? 'is-on' : ''}} mb-4">
    <view class="sub-kicker">{{subscribed ? '已预约提醒（演示）' : '清明前提醒'}}</view>
    <view class="sub-title">提前 7 / 3 / 1 天</view>
    <view class="muted sub-copy">{{subscribed ? '演示状态已记下。正式版配置模板 ID 后，会在清明前轻轻提醒家人。' : '到时候轻轻提醒家人准备物资、出门看望。你可以选择接收：'}}</view>
    <view wx:if="{{!subscribed}}" class="sub-list">
      <view>清明将至</view>
      <view>物资清单进度</view>
      <view>家庭排程</view>
    </view>
    <button wx:if="{{!subscribed}}" class="btn-primary mt-3" style="height:88rpx;font-size:28rpx;" bindtap="optIn">开启清明提醒</button>
    <button wx:else class="btn-secondary mt-3" style="height:88rpx;font-size:28rpx;" bindtap="optIn">查看演示说明</button>
  </view>

  <view wx:for="{{schedules}}" wx:key="id" class="card mb-3">
    <view class="row">
      <view class="sched-title">{{item.type}} · {{item.nextLabel}}</view>
      <view wx:if="{{item.countdown}}" class="chip chip-on">{{item.countdown}}</view>
    </view>
    <view class="muted mt-2">原定 {{item.date}} · {{item.ruleLabel}}</view>
    <view class="muted mt-1">{{item.meta}}</view>
    <view class="chip-row">
      <view wx:for="{{item.remindChips}}" wx:for-item="c" wx:key="*this" class="chip">{{c}}</view>
    </view>
    <view wx:if="{{canEdit}}" class="muted del" bindtap="remove" data-id="{{item.id}}">删除</view>
  </view>
  <empty-state wx:if="{{!schedules.length}}" title="暂无排程" description="把清明、忌日记下来，到时候轻轻提醒家人。" action-label="新建排程" bind:action="goNew" />

  <view wx:if="{{sheetVisible}}" class="sheet-mask" bindtap="closeSheet">
    <view class="sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-title">已预约提醒（演示）</view>
      <view class="muted sheet-body">开发者工具 / 未配置模板时仅演示 UI；正式版在 utils/subscribe.js 填入模板 ID 后即可真机授权推送。</view>
      <button class="btn-primary" bindtap="closeSheet">知道了</button>
    </view>
  </view>
</view>
