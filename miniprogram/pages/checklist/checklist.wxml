<view class="page" wx:if="{{missing}}">
  <empty-state
    title="{{empty.title}}"
    action-label="{{empty.cta}}"
    bind:action="createFromTemplate"
  />
</view>
<view class="page checklist" wx:else>
  <view class="row mb-2">
    <view class="progress-pill">{{checked}}/{{total}}</view>
    <view wx:if="{{canEdit}}" class="chip" bindtap="toggleEdit">{{editing ? '完成' : '编辑'}}</view>
  </view>
  <view class="h1">{{list.title}}</view>
  <view class="muted mt-2 mb-2">{{meta}}</view>
  <view class="progress mb-3">
    <view class="progress-bar" style="width: {{progress}}%;"></view>
  </view>

  <view wx:for="{{list.items}}" wx:key="id" class="item-row">
    <view class="check {{item.checked ? 'on' : ''}}" bindtap="toggleItem" data-id="{{item.id}}"></view>
    <view class="flex1">
      <block wx:if="{{editing}}">
        <input class="field mb-2" value="{{item.name}}" bindblur="onItemName" data-id="{{item.id}}" />
        <view class="edit-row">
          <input class="field qty" type="number" value="{{item.qty}}" bindblur="onItemQty" data-id="{{item.id}}" />
          <view class="chip {{item.required ? 'chip-on' : ''}}" bindtap="toggleRequired" data-id="{{item.id}}">必备</view>
          <view class="chip danger" bindtap="deleteItem" data-id="{{item.id}}">删除</view>
        </view>
      </block>
      <block wx:else>
        <view class="item-name {{item.checked ? 'done' : ''}}">{{item.name}}</view>
        <view class="muted caption">{{item.caption}}</view>
      </block>
    </view>
  </view>

  <empty-state wx:if="{{!list.items.length}}" title="清单是空的" description="点下方添加，或从模板重置。" />

  <button wx:if="{{editing && canEdit}}" class="btn-secondary mt-4" bindtap="addItem">＋ 添加一项</button>
  <button wx:if="{{canEdit}}" class="btn-secondary mt-3" bindtap="reset">从模板重置</button>
  <button wx:if="{{canEdit}}" class="btn-text mt-2" bindtap="cloneNew">再克隆一份新清单</button>
</view>
