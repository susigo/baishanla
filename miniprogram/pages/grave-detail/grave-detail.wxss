.action-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 36rpx;
}
.action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 0 16rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(47, 58, 54, 0.05);
  color: #2F3A36;
  font-size: 22rpx;
  font-weight: 600;
}
.action-ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #E5F0EB;
  color: #5F9483;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}
.action-primary .action-ico {
  background: #7BAF9E;
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(123, 175, 158, 0.35);
}
