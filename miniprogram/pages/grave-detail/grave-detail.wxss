.sub { line-height: 1.5; }
.action-grid {
  margin-top: 36rpx;
  gap: 16rpx;
}
.pill {
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  box-sizing: border-box;
}
.pill.primary {
  background: #7BAF9E;
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(123, 175, 158, 0.3);
}
.pill.secondary {
  background: #fff;
  color: #5F9483;
  border: 3rpx solid #7BAF9E;
}
.pill.dashed {
  background: #fff;
  color: #5F9483;
  border: 3rpx dashed #7BAF9E;
}
.card-h { font-weight: 600; margin-bottom: 12rpx; }
.recent-line {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #F0EBE0;
  font-size: 28rpx;
}
.recent-line:last-child { border-bottom: none; }
.sched { margin-top: 8rpx; line-height: 1.5; }
