<view class="page" wx:if="{{missing}}">
  <empty-state title="未找到墓地" description="可能已被删除，或换了一个家庭。" />
</view>
<view class="page" wx:else>
  <hills-art height="150" label="{{grave.coverLabel}}" cover-path="{{grave.coverPath}}" motif="{{grave.coverMotif}}" />
  <view class="h1 mt-3">{{grave.name}}</view>
  <view class="muted mt-2 sub">{{grave.memorialFor}} · {{noteShort}}</view>

  <view class="grid-2 action-grid">
    <button class="pill secondary" bindtap="navigate">导航</button>
    <button class="pill primary" bindtap="goVisitNew">记一笔</button>
    <button class="pill dashed" bindtap="goChecklist">清单</button>
    <button class="pill dashed" bindtap="goSchedules">排程</button>
  </view>

  <view class="card mt-4">
    <view class="card-h">近期记录</view>
    <view wx:if="{{recentItems.length}}" class="recent-list">
      <view wx:for="{{recentItems}}" wx:key="id" class="recent-line" bindtap="goVisit" data-id="{{item.id}}">
        <text class="ink">{{item.title}}</text>
        <text class="muted">{{item.dateShort}}</text>
      </view>
    </view>
    <view wx:else class="muted">{{recentLabel}}</view>
  </view>

  <view class="card-dash mt-3" bindtap="goEdit">{{locLabel}}</view>

  <view wx:if="{{schedules.length}}" class="card mt-3">
    <view class="card-h mb-2">绑定排程</view>
    <view wx:for="{{schedules}}" wx:key="id" class="muted sched">{{item.line}}</view>
  </view>

  <button class="btn-text mt-4" bindtap="moreActions">编辑 / 新建排程</button>
</view>
