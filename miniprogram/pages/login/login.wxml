<view class="page spring">
  <view class="relative">
    <view class="mb-3 mt-2">
      <hills-art height="120" />
    </view>
    <view class="login-brand">拜山啦</view>
    <view class="sprout-line">新芽</view>
    <view wx:if="{{pendingInvite}}" class="invite-chip mb-3">收到邀请，登录后将预填加入</view>
    <view class="card form-card">
      <view class="muted mb-3">微信登录为本地会话占位，未接真实 code2session。</view>
      <button class="btn-wx mb-4" bindtap="mockWx">微信一键登录</button>
      <view class="muted mb-3">或手机号验证码 · 演示码 123456</view>
      <view class="muted label">手机号</view>
      <input class="field mb-3" type="number" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhone" />
      <view class="muted label">验证码</view>
      <view class="row mb-2">
        <input class="field" style="flex:1;" type="number" placeholder="6 位验证码" value="{{code}}" bindinput="onCode" />
        <button class="btn-ghost" style="margin-left:16rpx;flex-shrink:0;" bindtap="sendCode">{{sent ? '已发送' : '获取验证码'}}</button>
      </view>
      <view wx:if="{{err}}" class="blush mb-2">{{err}}</view>
      <view wx:if="{{sent}}" class="sage mb-3" style="font-size:24rpx;">已发送（演示）：123456</view>
      <button class="btn-primary mt-3" bindtap="submitPhone">登录</button>
    </view>
    <button class="btn-text mt-3" bindtap="enterDemo">进入演示 · 小林家</button>
  </view>
</view>
