<view class="page" wx:if="{{missing}}">
  <view class="muted">未找到</view>
</view>
<view class="page" wx:else>
  <view class="h1">{{visit.title || '看望'}}</view>
  <view class="muted mt-2">{{meta}}</view>
  <view class="body">{{visit.body || '（无正文）'}}</view>
  <view wx:if="{{visit.photos.length}}" class="grid-2 mt-4">
    <image wx:for="{{visit.photos}}" wx:key="*this" class="photo-slot" src="{{item}}" mode="aspectFill" />
  </view>
  <view wx:else class="grid-2 mt-4">
    <view class="cover-photo photo-wide"></view>
    <view class="cover-photo photo-wide blush-tone"></view>
  </view>
</view>
