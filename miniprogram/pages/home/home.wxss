.family-row { padding-top: 4rpx; }
.family-name {
  font-weight: 600;
  font-size: 34rpx;
  letter-spacing: 1rpx;
}
.chev { color: #6B776F; font-weight: 400; }

.hero-next {
  padding: 36rpx 36rpx 32rpx;
  position: relative;
  overflow: hidden;
}
.hero-next::after {
  content: "";
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(231,184,176,0.35), transparent 70%);
  pointer-events: none;
}
.hero-kicker {
  font-size: 24rpx;
  color: #6B776F;
  letter-spacing: 2rpx;
}
.hero-date {
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin: 12rpx 0 10rpx;
  color: #2F3A36;
}
.hero-meta { color: #6B776F; font-size: 26rpx; }
.countdown {
  margin-top: 12rpx;
  display: inline-flex;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.7);
  color: #5F9483;
  font-size: 22rpx;
  font-weight: 600;
}

.chip-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.btn-note { gap: 12rpx; }
.note-ico { font-size: 30rpx; line-height: 1; }

.progress-card { padding: 28rpx 32rpx 32rpx; }
.progress-title { font-weight: 600; font-size: 30rpx; }
.progress-sub { font-size: 22rpx; margin-top: 6rpx; }
.progress-count { color: #6B776F; font-size: 26rpx; font-weight: 600; }

.section-label { font-size: 24rpx; letter-spacing: 2rpx; }

.recent {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
  margin-bottom: 16rpx;
}
.recent-photo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.recent-body { flex: 1; min-width: 0; }
.recent-title { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.side { font-size: 22rpx; flex-shrink: 0; }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-top: 4rpx; }
.date-line { font-size: 22rpx; margin-top: 6rpx; }

.promo { position: relative; padding-right: 56rpx; }
.promo-x {
  position: absolute;
  right: 20rpx;
  top: 16rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6B776F;
  font-size: 36rpx;
  z-index: 2;
}
.promo-title { font-weight: 600; font-size: 32rpx; }
.promo-line { color: #6B776F; font-size: 26rpx; margin: 8rpx 0 16rpx; line-height: 1.5; }
.promo-cta { display: inline-flex; }
