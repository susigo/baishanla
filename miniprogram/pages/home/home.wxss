.family-name {
  font-weight: 600;
  font-size: 32rpx;
}

.next-date {
  font-size: 40rpx;
  font-weight: 600;
  margin: 12rpx 0 8rpx;
}

.chip-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.recent {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.recent-body { flex: 1; min-width: 0; }
.recent-title { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-top: 4rpx; }
