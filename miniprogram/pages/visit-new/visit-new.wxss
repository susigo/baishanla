.compose { padding-top: 16rpx; }
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}
.publish-link {
  color: #5F9483;
  font-weight: 600;
  font-size: 30rpx;
  padding: 12rpx 8rpx;
}
.publish-link.dim { opacity: 0.5; }
.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.chev { color: #6B776F; font-size: 24rpx; }
.photo-label { letter-spacing: 1rpx; }
.wrap { position: relative; }
.photo-img { width: 100%; height: 100%; display: block; border-radius: 24rpx; }
.photo-x {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(47, 58, 54, 0.55);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.list-toggle { justify-content: flex-start; gap: 24rpx; }
.list-toggle-text { font-size: 28rpx; }
.tip { margin-top: 24rpx; font-size: 22rpx; line-height: 1.5; text-align: center; }
