<view class="page page-tab">
  <view class="row mb-3">
    <view>
      <view class="h1">记录</view>
      <view class="muted sub" wx:if="{{total}}">共 {{total}} 次看望 · 按年归档</view>
    </view>
    <button class="btn-ghost" style="height:72rpx;" bindtap="goNew">✎ 记一笔</button>
  </view>
  <view wx:for="{{groups}}" wx:key="year" class="year-block mb-4">
    <view class="year-head">
      <text class="year">{{item.year}}</text>
      <text class="muted">{{item.count}} 篇</text>
    </view>
    <view wx:for="{{item.items}}" wx:for-item="v" wx:key="id" class="card visit-row" bindtap="goDetail" data-id="{{v.id}}">
      <image wx:if="{{v.photo}}" class="thumb-img" src="{{v.photo}}" mode="aspectFill" />
      <cover-thumb wx:else size="48" motif="{{v.motif}}" />
      <view class="visit-body">
        <view class="row">
          <view class="title">{{v.title}}</view>
          <view class="muted date">{{v.dateShort}}</view>
        </view>
        <view class="muted ellipsis">{{v.line}}</view>
        <view class="meta-row">
          <text wx:if="{{v.author}}" class="muted author">{{v.author}}</text>
          <text wx:if="{{v.photoCount}}" class="chip mini">{{v.photoCount}} 图</text>
        </view>
      </view>
    </view>
  </view>
  <empty-state wx:if="{{!groups.length}}" title="{{empty.title}}" action-label="{{empty.cta}}" bind:action="goNew" />
</view>
