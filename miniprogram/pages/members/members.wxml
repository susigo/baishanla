<view class="page">
  <view class="card invite-card mb-4">
    <view class="muted">邀请家人加入{{familyName}}</view>
    <view class="token">{{token}}</view>
    <view class="muted invite-hint">分享卡片带上邀请码；对方打开后可预填加入。演示无服务端校验。</view>
    <button class="btn-primary mt-3" open-type="share">邀请家人</button>
    <button class="btn-secondary mt-3" bindtap="copy">{{copied ? '已复制' : '复制邀请码'}}</button>
  </view>
  <view wx:for="{{members}}" wx:key="userId" class="card row mb-3">
    <view>
      <view style="font-weight:600;">{{item.nickname}}</view>
      <view class="muted" style="font-size:22rpx;margin-top:4rpx;">加入于 {{item.joinedAt}}</view>
    </view>
    <view class="chip">{{item.roleLabel}}</view>
  </view>
</view>
