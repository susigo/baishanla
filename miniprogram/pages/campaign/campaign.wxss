.campaign { padding-top: 16rpx; }
.badge {
  display: inline-flex;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #E7B8B0;
  color: #2F3A36;
  font-size: 22rpx;
  font-weight: 600;
  align-items: center;
}
.slogan {
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  margin-top: 20rpx;
  color: #2F3A36;
}
.hook {
  font-size: 40rpx;
  font-weight: 600;
  color: #5F9483;
  letter-spacing: 2rpx;
  margin: 12rpx 0 20rpx;
}
.lead {
  color: #2F3A36;
  font-size: 28rpx;
  line-height: 1.7;
  margin-bottom: 24rpx;
}
.body-card { padding: 28rpx 32rpx; }
.para {
  line-height: 1.7;
  margin-bottom: 16rpx;
  color: #2F3A36;
}
.para:last-child { margin-bottom: 0; }
.benefits {
  color: #5F9483;
  font-size: 26rpx;
  line-height: 1.8;
}
